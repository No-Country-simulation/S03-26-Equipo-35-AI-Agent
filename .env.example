# ══════════════════════════════════════════════════════════
# AutoStory Builder — Variables de Entorno
# Copiar a .env y rellenar con valores reales
# NUNCA commitear .env — solo .env.example va al repo
# ══════════════════════════════════════════════════════════

# ── LLMs (orden de fallback: Gemini → Groq → OpenRouter) ──
GOOGLE_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
DEEPSEEK_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here

# ── Embeddings ──
COHERE_API_KEY=your_key_here

# ── Base de datos (Supabase) ──
SUPABASE_URL=your_project_url
SUPABASE_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# ── Base de datos de testing ──
SUPABASE_TEST_URL=your_test_project_url
SUPABASE_TEST_KEY=your_test_key

# ── Autenticación ──
JWT_SECRET=your_jwt_secret
JWT_ALGORITHM=HS256

# ── Cache & Rate Limiting (Upstash Redis) ──
# Obtener gratis en: https://console.upstash.com/
# Sin estas variables Redis se desactiva silenciosamente (app funciona igual)
UPSTASH_REDIS_URL=https://xxx.upstash.io
UPSTASH_REDIS_TOKEN=AXxx...

# Rate limits (opcional — valores default generosos para pruebas)
# RATE_LIMIT_GENERATE=20
# RATE_LIMIT_IMAGE=10
# RATE_LIMIT_INGEST=30
# RATE_LIMIT_GLOBAL=120

# ── Observabilidad ──
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=autostory-builder
LANGCHAIN_TRACING_V2=true
LOG_LEVEL=INFO

# ── Generación de Imágenes (Hugging Face) ──
HUGGINGFACE_API_KEY=your_hf_token_here

# ── Sistema ──
ENVIRONMENT=development
DRY_RUN=true
API_BASE_URL=http://localhost:8000
