# ══════════════════════════════════════════════════════════
# AutoStory Builder — Variables de Entorno
# Copiar a .env y rellenar con valores reales
# NUNCA commitear .env — solo .env.example va al repo
# ══════════════════════════════════════════════════════════

# ── LLMs (orden de fallback: Gemini → Groq → OpenRouter) ──
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ── Embeddings ──
COHERE_API_KEY=

# ── Base de datos (Supabase) ──
# Obtener desde: Supabase Dashboard → Settings → API
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# ── Base de datos de testing ──
SUPABASE_TEST_URL=
SUPABASE_TEST_KEY=

# ── Autenticación ──
JWT_SECRET=
JWT_ALGORITHM=HS256

# ── Cache (Upstash Redis) ──
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ── Observabilidad ──
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=autostory-builder
LOG_LEVEL=INFO

# ── Sistema ──
ENVIRONMENT=development
DRY_RUN=true
