# ══════════════════════════════════════════════════════════
# AutoStory Builder — Variables de Entorno
# Copiar a .env y rellenar con valores reales
# NUNCA commitear .env — solo .env.example va al repo
# ══════════════════════════════════════════════════════════

# ── LLMs (orden de fallback: Gemini → Groq → OpenRouter) ──
GOOGLE_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
DEEPSEEK_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here

# ── Embeddings ──
COHERE_API_KEY=your_key_here

# ── Base de datos (Supabase) ──
SUPABASE_URL=your_project_url
SUPABASE_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# ── Base de datos de testing ──
SUPABASE_TEST_URL=your_test_project_url
SUPABASE_TEST_KEY=your_test_key

# ── Autenticación ──
JWT_SECRET=your_jwt_secret
JWT_ALGORITHM=HS256

# ── Cache (Upstash Redis) ──
UPSTASH_REDIS_URL=your_redis_url
UPSTASH_REDIS_TOKEN=your_redis_token

# ── Observabilidad ──
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=autostory-builder
LANGCHAIN_TRACING_V2=true
LOG_LEVEL=INFO

# ── Sistema ──
ENVIRONMENT=development
DRY_RUN=true
